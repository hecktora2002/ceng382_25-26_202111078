@page
@model RAZOR_PAGE_KOPYASI.Pages.TableModel
@{
    ViewData["Title"] = "Class Table";
}

<!-- Sayfanın geri kalanı (Add Class formu, filtreleme, tablo vs.) burada olacak -->

<!-- Bu kısmı senin mevcut içeriğinle bırakıyoruz -->
<div class="container">
    <div class="row">
        <!-- Sol: Add Class -->
        <div class="col-md-4">
            <div class="card p-3">
                <h5 class="mb-3">Add Class</h5>
                <form method="post">
                    <div class="mb-2">
                        <label>Class Name</label>
                        <input class="form-control" name="ClassName" />
                    </div>
                    <div class="mb-2">
                        <label>Student Count</label>
                        <input type="number" class="form-control" name="StudentCount" value="0" />
                    </div>
                    <div class="mb-2">
                        <label>Description</label>
                        <textarea class="form-control" name="Description"></textarea>
                    </div>
                    <button class="btn btn-primary"><i class="bi bi-plus-circle"></i> Add Class</button>
                </form>
            </div>
        </div>

        <!-- Sağ: Class List -->
        <div class="col-md-8">
            <div class="card p-3">
                <h5 class="mb-3">Class List</h5>
                <div class="mb-2 d-flex">
                    <input class="form-control me-2" placeholder="Filter by Class Name" />
                    <button class="btn btn-outline-primary"><i class="bi bi-search"></i> Filter</button>
                </div>

                <table class="table table-striped">
                    <thead class="table-dark">
                        <tr>
                            <th>Class Name</th>
                            <th>Student Count</th>
                            <th>Description</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Veriler burada dönecek -->
                        <tr>
                            <td>Class 1</td>
                            <td>21</td>
                            <td>Theory Section</td>
                            <td>
                                <button class="btn btn-sm btn-info"><i class="bi bi-pencil"></i></button>
                                <button class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></button>
                            </td>
                        </tr>
                        <!-- devamı -->
                    </tbody>
                </table>

                <nav>
                    <ul class="pagination">
                        <li class="page-item active"><a class="page-link" href="#">1</a></li>
                        <li class="page-item"><a class="page-link" href="#">2</a></li>
                        <!-- devamı -->
                    </ul>
                </nav>

                <div class="mt-3">
                    <p><strong>Export Options</strong></p>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" checked />
                        <label class="form-check-label">Class Name</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" checked />
                        <label class="form-check-label">Student Count</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" checked />
                        <label class="form-check-label">Description</label>
                    </div>

                    <div class="mt-2">
                        <button class="btn btn-outline-secondary">Export Current Page to JSON</button>
                        <button class="btn btn-outline-dark">Export All to JSON</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ✅ SESSION INFO Kutusu (Sol Alt Köşe) -->
<div style="position: fixed; bottom: 10px; left: 10px; background-color: #f1f1f1; padding: 10px; border-radius: 6px; font-size: 13px; box-shadow: 0 0 8px rgba(0,0,0,0.1);">
    <p><strong>Session Info</strong></p>
    <p>Username: @Model.DisplayUsername</p>
    <p>Token: @Model.DisplayToken</p>
    <p>Session ID: @Model.DisplaySessionId</p>
</div>
