@page
@model MyApp.Pages.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<h2>Register</h2>

<form method="post" class="mt-3">
    <div class="mb-2">
        <input asp-for="Input.FirstName" class="form-control" placeholder="First Name" />
    </div>
    <div class="mb-2">
        <input asp-for="Input.LastName" class="form-control" placeholder="Last Name" />
    </div>
    <div class="mb-2">
        <input asp-for="Input.Email" class="form-control" placeholder="Email" />
    </div>
    <div class="mb-2">
        <input asp-for="Input.Password" type="password" class="form-control" placeholder="Password" />
    </div>
    <button type="submit" class="btn btn-success">Register</button>
</form>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-danger mt-2">@Model.Message</div>
}
